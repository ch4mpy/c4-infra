# Edge of the demo host: the shared services on {$INFRA_HOST}, and one site per application
# (apps/*.caddy, installed by each application's deployment through register-app.sh). Caddy gets a
# Let's Encrypt certificate per site, sets X-Forwarded-* itself and streams text/event-stream
# responses (the gateways' SSE) unbuffered.

# Headers every site sends; the applications' sites import them too. Caddy does not send HSTS on
# its own.
(common-headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# For the single-page applications only. Keycloak serves its own pages under /auth/* and uses
# iframes for session status, so a blanket frame-ancestors would be its problem, not theirs.
(spa-headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

{$INFRA_HOST} {
	encode zstd gzip
	import common-headers

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# RFC 8414 discovery, which MCP clients use: the well-known path is inserted before the
	# issuer's path, on the issuer's host (this one), for every realm
	@realm-discovery path_regexp discovery ^/\.well-known/(oauth-authorization-server|openid-configuration)/auth/realms/([A-Za-z0-9_.-]+)$
	handle @realm-discovery {
		rewrite * /auth/realms/{re.discovery.2}/.well-known/{re.discovery.1}
		reverse_proxy keycloak:8080
	}

	handle /mailpit/* {
		basic_auth {
			demo {$MAILPIT_UI_PASSWORD_HASH}
		}
		reverse_proxy mailpit:8025
	}

	handle /grafana/* {
		reverse_proxy grafana-lgtm:3000
	}

	handle {
		respond "c4-infra: the applications are on their own host names" 404
	}
}

import apps/*.caddy
