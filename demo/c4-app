#!/bin/bash
# The one command an application's account on the demo host runs as root (intent 0002): the account
# is in the group c4-apps, outside the docker group, and /etc/sudoers.d/c4-infra
# (demo/vps-bootstrap.sh) lets that group run this file, which demo/deploy.sh installs root-owned as
# /usr/local/sbin/c4-app. The application is the account that runs it (SUDO_USER), never an
# argument:
#
#   sudo c4-app pull [--registry <host> --registry-user <user>]
#                                   pulls the images of the application's compose project; with
#                                   --registry, logs in first with the token read on stdin, in a
#                                   temporary Docker configuration removed at once
#   sudo c4-app up                  starts the project, or brings it up to date, and waits until it
#                                   runs (healthy where it has a healthcheck); refuses, before any
#                                   container starts, a project that leaves its isolation (below),
#                                   then makes sure of the application's network c4-infra.<application>
#                                   (networks.sh ensure); every container keeps a bounded log (below)
#   sudo c4-app down                stops and removes the project's containers and networks by the
#                                   project's name, reading no compose file (its volumes stay)
#   sudo c4-app register <option>…  bash /home/c4-infra/c4-infra/register-app.sh --app <application>
#                                   with register-app.sh's options (README.md) but --app: paths are
#                                   relative to ~/<application>/, and --rabbitmq-password-env <VAR>
#                                   takes VAR from ~/<application>/.env
#   sudo c4-app backup              backs up what the project declares (intent 0027), read from its
#                                   running containers: a service labelled c4-infra.backup: postgres
#                                   dumped hot in its container (pg_dump -Fc), one labelled volumes
#                                   has its named volumes copied, its containers stopped meanwhile;
#                                   into /var/backups/c4-apps/<application>/<stamp>/ (0750, files 0640,
#                                   root:<application>), kept 7 days, refused under the disk's floor
#   sudo c4-app restore [<stamp> --yes]
#                                   lists the backups; with a stamp and --yes, backs up the current
#                                   state, then restores that backup (README.md, "Backups")
#   c4-app nightly                  root's cron only (/etc/cron.d/c4-apps-backup, 03:45): backup as
#                                   each account of the group c4-apps, into its backup.log
#
# pull, up and register work on a copy of ~/<application>/<application>/ (sent there by the
# application's workflow), read as the application and written by root into
# /var/lib/c4-apps/.<application>.incoming/ (root:<application>, mode 0750: the application reads it,
# never writes it); a symbolic link or a special file in it is refused. Only up, once its checks have
# passed and its images are there, puts it in place in /var/lib/c4-apps/<application>/, the
# containers' only mount sources: a refused command leaves what the running containers read as it
# was (intent 0025). What root itself reads — the compose model, and (for register) the realm, routes and theme files — is a
# fresh root-only snapshot in /var/lib/c4-apps/.run.<application>/ (mode 0700 root:root), outside
# anything a container may mount, taken once the checks have passed and used from there. The compose
# model is read as the application (`docker compose config`: no daemon, and no file its account can't
# read, such as another application's env_file) into .run.<application>/model.json, which root's
# `docker compose` runs as the project <application>; root reads nothing of the application's copy on
# its behalf. It is read from the incoming copy, its paths named as /var/lib/c4-apps/<application>/'s:
# the ones the containers mount once up puts the copy in place. The project's name is always the
# application's: both composes get -p <application>, which wins over a top-level name: of the
# application's file.
#
# `up` and `pull` check that model first, before root's compose touches it (intent 0007, RQ-09):
# compose runs a provider's and a hook's executables, so an unchecked model must never reach it.
# `down` hands compose no model at all (intent 0011): it stops the project by its name, whatever the
# file holds now. The check is an allowlist — the top-level keys, the service keys, and the
# sub-keys/values of the nested objects that can escape (deploy, security_opt, volumes and networks
# entries) that an application may use; anything else is refused, naming the service (or
# network/volume) and the key (CHECKS below; the list is also in README.md, "Accounts"). What is
# allowed, in short:
#   - top level: services, networks, volumes, secrets, configs;
#   - a service: its image (the demo host builds none: the application's CI pushes its images to a
#     registry, intent 0011), container_name and network aliases under
#     <application>., its command/entrypoint/environment/env_file, expose (never ports), its own
#     networks and named volumes, read-only bind mounts inside /var/lib/c4-apps/<application>/,
#     healthcheck, depends_on, resource limits, and the usual hardening (read_only, cap_drop, user,
#     tmpfs, init, security_opt: no-new-privileges). A service name is [a-z0-9_-]+ (no dot: a dotted
#     name would be an alias on the shared network).
#   - refused with their own clearer message: a service that builds; a service named after a shared
#     service (keycloak, mailpit, rabbitmq, grafana-lgtm, reverse-proxy, keycloak-db); a
#     published port; privileged, cap_add, devices, device_cgroup_rules, a deploy reservation of host
#     devices; network_mode, links, external_links, volumes_from; pid/ipc/uts/userns_mode/cgroup set
#     to host or another container;
#     a read-write bind mount, or one of the staging root or outside it (the Docker socket, another
#     application's files…); an external network or volume, one with a name or driver of its own, or
#     driver_opts; logging (the host's: below).
#   - refused by the allowlist (not an application's to set): use_api_socket, post_start/pre_stop
#     hooks, a provider service, and anything else not listed above.
#
# `up` gives every service of the checked model the host's bound on its logs (LOG_BOUND, 0026).
#
# A registration runs with the shared stack's registration credential, in
# /home/c4-infra/c4-infra/.env (mode 600, the c4-infra account's), which only root reads; it touches
# only what the application's registry entry assigns to it (register-app.sh).
set -euo pipefail
umask 027
cd /

# Nothing of the caller's environment: sudo already resets it, this keeps only what follows
for name in $(compgen -e); do
  case "$name" in
    SUDO_USER) ;;
    *) unset "$name" 2> /dev/null || true ;;
  esac
done
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LC_ALL=C.UTF-8

STACK=/home/c4-infra/c4-infra
STAGING_ROOT=/var/lib/c4-apps
# the applications' backups (intent 0027), outside anything a container may mount
BACKUP_ROOT=/var/backups/c4-apps
KEEP_DAYS=7
# PA-05: a backup is refused under 5 GiB free, or under 10 % of the disk when that is more
FLOOR_MIN=$((5 * 1024 * 1024 * 1024))
# The time limits (intent 0033), in seconds: a backup's item, a restore's step, an application's
# nightly run; root's own /etc/c4-app/limits may change them (read_limits)
LIMITS=/etc/c4-app/limits
ITEM_TIMEOUT=1800
RESTORE_TIMEOUT=3600
NIGHTLY_TIMEOUT=7200

fail() {
  echo "c4-app: $*" >&2
  exit 1
}
usage() {
  cat >&2 <<'EOF'
Usage, from an application's account:
  sudo c4-app pull [--registry <host> --registry-user <user>]   (token on stdin)
  sudo c4-app up
  sudo c4-app down
  sudo c4-app register [--realm <file>]... [--themes <dir>] [--proxy <routes file>]
                       [--rabbitmq-user <user> --rabbitmq-password-env <VAR of .env>] [--reset-realms]
  sudo c4-app backup                    (the services labelled c4-infra.backup: postgres or volumes,
                                        into /var/backups/c4-apps/<app>/, nightly at 03:45 too)
  sudo c4-app restore [<stamp> --yes]
EOF
  exit 2
}

# PA-03 B: the limits from root's file, read as data (never sourced), each 1 to 86400 s (a 0 would turn
# timeout off); without the file, the defaults; anything else refuses, the reason in limits_refusal
limits_refusal=
read_limits() {
  local line number=0 dir=${LIMITS%/*}
  [ -e "$LIMITS" ] || [ -L "$LIMITS" ] || return 0
  if [ -L "$LIMITS" ] || [ ! -f "$LIMITS" ] || [ -L "$dir" ] \
    || [[ ! $(stat -c '%u %g %a' "$LIMITS") =~ ^0\ 0\ [0-7]?[0-7][0145][0145]$ ]] \
    || [[ ! $(stat -c '%u %a' "$dir") =~ ^0\ [0-7]?[0-7][0145][0145]$ ]]; then
    limits_refusal="$LIMITS: not root's own regular file (root:root, writable by root only, in a directory of root's): refused"
    return 1
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    number=$((number + 1))
    [[ ! $line =~ ^[[:space:]]*(#.*)?$ ]] || continue
    if [[ $line =~ ^(ITEM_TIMEOUT|RESTORE_TIMEOUT|NIGHTLY_TIMEOUT)=([1-9][0-9]{0,4})$ ]] && [ "${BASH_REMATCH[2]}" -le 86400 ]; then
      printf -v "${BASH_REMATCH[1]}" %s "${BASH_REMATCH[2]}"
    else
      limits_refusal="$LIMITS, line $number: '${line//[^[:print:]]/?}': <KEY>=<seconds>, 1 to 86400, KEY ITEM_TIMEOUT, RESTORE_TIMEOUT or NIGHTLY_TIMEOUT"
      return 1
    fi
  done < "$LIMITS"
}

[ "$(id -u)" -eq 0 ] || fail "runs as root, through sudo: sudo c4-app <command>"

# Root's cron only (sudo sets SUDO_USER): each account of c4-apps backs up as itself, into its log; a
# refused limits file is written into each log
nightly() {
  local members member log code status=0 refusal=
  read_limits || refusal="c4-app: $limits_refusal"
  members=$(getent group c4-apps | cut -d: -f4)
  install -d -m 0755 -o root -g root "$BACKUP_ROOT"
  for member in ${members//,/ }; do
    if ! [[ $member =~ ^[a-z][a-z0-9-]*$ ]] || ! getent group "$member" > /dev/null; then
      echo "c4-app: nightly: $(printf %q "$member") is not an application's account: skipped" >&2
      status=1
      continue
    fi
    install -d -m 0750 -o root -g "$member" "$BACKUP_ROOT/$member"
    log=$BACKUP_ROOT/$member/backup.log
    [ -e "$log" ] || install -m 0640 -o root -g "$member" /dev/null "$log"
    {
      echo "== $(date -u '+%Y-%m-%d %H:%M:%S') UTC: nightly backup of $member"
      code=0
      if [ -n "$refusal" ]; then
        echo "$refusal"
        code=1
      else
        timeout --kill-after=60 "$NIGHTLY_TIMEOUT" runuser -u "$member" -- sudo -n /usr/local/sbin/c4-app backup < /dev/null 2>&1 \
          || code=$?
      fi
      if [ "$code" -eq 124 ] || [ "$code" -eq 137 ]; then
        echo "== exit $code: stopped after $NIGHTLY_TIMEOUT s"
      else
        echo "== exit $code"
      fi
    } >> "$log"
    [ "$code" -eq 0 ] || status=1
  done
  return "$status"
}
if [ "${1:-}" = nightly ]; then
  [ -z "${SUDO_USER:-}" ] || fail "nightly is root's cron's (/etc/cron.d/c4-apps-backup), not an application's"
  [ $# -eq 1 ] || usage
  nightly
  exit
fi

app=${SUDO_USER:-}
case "$app" in
  '') fail "runs through sudo, from an application's account: sudo c4-app <command>" ;;
  root | c4-infra) fail "$app is not an application's account" ;;
esac
[[ $app =~ ^[a-z][a-z0-9-]*$ ]] || fail "$app is not an application's name"

# The application is in the shared stack's registry (never another file: REGISTRY_FILE is unset with
# the rest of the environment)
# shellcheck source=../registry.sh
source "$STACK/registry.sh"
registry_check || fail "the shared stack's registry ($STACK/registry.txt) is invalid (above)"
registry_entry "$app" || fail "$app is not in the shared stack's registry ($STACK/registry.txt)"

source_dir=/home/$app/$app
staging=$STAGING_ROOT/$app
incoming=$STAGING_ROOT/.$app.incoming
# root-only, outside anything a container may mount (not inside $staging): the model root's compose
# runs, and the snapshot of the inputs root reads for register
snap=$STAGING_ROOT/.run.$app
snap_src=$snap/src
model=$snap/model.json
# 0750 root:<app>: the application reads its backups, never writes there
backups=$BACKUP_ROOT/$app

# One command at a time per application; one that has to wait says so
install -d -m 0755 -o root -g root "$STAGING_ROOT"
exec 9> "$STAGING_ROOT/.$app.lock"
if ! flock -n 9; then
  echo "c4-app: waiting for another c4-app command of $app (600 s at most)" >&2
  flock -w 600 9 || fail "another c4-app command of $app is still running"
fi

# On the way out: no incoming copy, no unfinished backup, the stopped containers started unless restoring
partial=
stopped=()
restoring=
safety=
altered=
leave() {
  local status=$?
  rm -rf "$incoming"
  [ -z "$partial" ] || rm -rf "$partial"
  if [ -n "$altered" ]; then
    echo "c4-app: the restore of backup $restoring failed (above) once it had begun replacing $app's data: its containers stay stopped (${stopped[*]}). To put the state before back: sudo c4-app restore $safety --yes, then sudo c4-app up; to start $app as it is: sudo c4-app up" >&2
    return
  fi
  [ ${#stopped[@]} -eq 0 ] || docker start "${stopped[@]}" > /dev/null \
    || echo "c4-app: ${stopped[*]} could not be started again (above)" >&2
  [ "$status" -eq 0 ] || [ -z "$restoring" ] \
    || echo "c4-app: the restore of backup $restoring failed (above), before it changed any data: its containers run again" >&2
}
trap leave EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# The application's files, read as it, links and special files refused, into the incoming copy
# (0750 root:<app>); the root-only snapshot directory (re)created empty
copy_in() {
  local found
  [ -d "$source_dir" ] || fail "$source_dir is missing: the application's workflow sends its files there first"
  rm -rf "$incoming" "$snap"
  install -d -m 0700 -o root -g root "$incoming"
  if ! runuser -u "$app" -- tar -C "$source_dir" -cf - . \
    | tar -C "$incoming" -xf - --no-same-owner --no-same-permissions; then
    fail "$source_dir could not be copied (above)"
  fi
  # (head may close the pipe early: its status, not find's)
  found=$(find "$incoming" -mindepth 1 ! -type f ! -type d -printf '%P\n' | head -n 5 || true)
  [ -z "$found" ] || fail "$source_dir holds a symbolic link or a special file, refused: ${found//$'\n'/, }"
  chown -R "root:$app" "$incoming"
  chmod -R u+rwX,g+rX,g-w,o-rwx "$incoming"
  # the snapshot directory root reads from: root-only, no container may mount it (not inside $staging)
  install -d -m 0700 -o root -g root "$snap"
}

# The containers' mount sources, 0750 root:<app>; compose's project directory too
staging_dir() { install -d -m 0750 -o root -g "$app" "$staging"; }

# The model's images up would pull, before the files change: one neither on the host nor pullable
# refuses the deployment here (compose pull --policy missing pulls an image the host has: 0025)
pull_missing() {
  local image
  for image in $(jq -r '[.services[].image // empty] | unique[]' "$model"); do
    docker image inspect "$image" > /dev/null 2>&1 && continue
    docker pull --quiet "$image" > /dev/null \
      || fail "the image $image is neither on the host nor pullable (above): nothing was changed"
  done
}

# The checked copy into place, in the same directory: a running container's mount sees the new files
place_copy() {
  staging_dir
  rsync -a --delete "$incoming/" "$staging/"
}

# A root-only snapshot of the checked incoming copy: register reads its files there, out of every
# container's reach
snapshot_src() {
  rm -rf "$snap_src"
  cp -a "$incoming" "$snap_src"
}

# The compose model, read as the application from the incoming copy, into the root-only model file
# root's compose runs (root's redirection and mv, in $snap: no container can plant a symlink there).
# Its paths under the copy become the staging directory's, which the containers mount; one the
# rewrite would miss stays outside it, and check_model refuses it. Root writes the checked model to a
# new file: the application's process (its compose plugin, under its HOME) never holds it open.
read_model() {
  local config=$model.config
  [ -f "$incoming/compose.yml" ] || fail "$source_dir/compose.yml is missing"
  rm -f "$model" "$config"
  if ! runuser -u "$app" -- env -i PATH="$PATH" HOME="/home/$app" \
    docker compose --project-directory "$incoming" -p "$app" -f "$incoming/compose.yml" config --format json > "$config"; then
    rm -f "$config"
    fail "docker compose config refuses $source_dir/compose.yml (above)"
  fi
  if ! rewrite_model "$config" --arg from "$incoming" --arg to "$staging" \
    'walk(if type == "string" and (. == $from or startswith($from + "/")) then $to + .[($from | length):] else . end)'; then
    rm -f "$config"
    fail "the model's paths couldn't be named as $staging's (jq, above)"
  fi
  rm -f "$config"
}

# jq's output over <source> as the model: a new root-owned file moved into place, or no change
rewrite_model() { # <source> <jq argument>…
  local source=$1 next=$model.new
  shift
  rm -f "$next"
  if jq "$@" "$source" > "$next" && chown root:root "$next" && chmod 0640 "$next" && mv "$next" "$model"; then
    return 0
  fi
  rm -f "$next"
  return 1
}

# What leaves the application's isolation: an allowlist (the header's list; README's too). The keys
# an application may set — top-level, per service, and the sub-keys/values of the nested objects that
# can escape (deploy, security_opt, volumes and networks entries) — are listed; anything else
# is refused, naming the service (or network/volume) and the key. The escapes a specific message
# reads more clearly keep that message. One line per refusal.
CHECKS=$(cat <<'JQ'
def inside: . as $p | (($p == $root) or ($p | startswith($root + "/"))) and (($p | test("(^|/)[.][.](/|$)")) | not);
def reserved: ["keycloak", "mailpit", "rabbitmq", "grafana-lgtm", "reverse-proxy", "keycloak-db"];
def svc_allowed: [
  "image", "container_name", "command", "entrypoint", "environment", "env_file", "expose",
  "networks", "volumes", "depends_on", "healthcheck", "restart", "labels", "annotations", "user",
  "working_dir", "hostname", "read_only", "cap_drop", "init", "tmpfs", "stop_grace_period",
  "stop_signal", "stop_timeout", "mem_limit", "mem_reservation", "memswap_limit", "cpus", "cpuset",
  "cpu_shares", "shm_size", "pids_limit", "ulimits", "deploy", "secrets", "configs",
  "pull_policy", "platform", "stdin_open", "tty", "security_opt"];
def svc_refused: ["build", "network_mode", "links", "external_links", "ports", "privileged", "cap_add",
  "devices", "device_cgroup_rules", "pid", "ipc", "uts", "userns_mode", "cgroup", "volumes_from", "logging"];
def top_allowed: ["name", "services", "networks", "volumes", "secrets", "configs"];
def deploy_allowed: ["resources", "restart_policy", "labels", "replicas", "update_config",
  "rollback_config", "placement", "mode", "endpoint_mode"];

(keys[] | select(IN(top_allowed[]) | not)
  | "top-level key \(.): not allowed (an application provides services, networks, volumes, secrets, configs)"),

(.networks // {} | to_entries[] | .key as $k | (.value // {}) |
  (if .external == true then
    (if .name != "c4-infra.\($app)" then "network \($k): external, and not c4-infra.\($app) (\(.name))" else empty end)
  else
    (if (.name // "\($app)_\($k)") != "\($app)_\($k)" then "network \($k): a name of its own (\(.name))" else empty end),
    (if (.driver // "bridge") != "bridge" then "network \($k): driver \(.driver), not bridge" else empty end)
  end),
  (if (.driver_opts // {}) != {} then "network \($k): driver_opts" else empty end)),

(.volumes // {} | to_entries[] | .key as $k | (.value // {}) |
  (if .external == true then "volume \($k): external (\(.name // $k))"
   elif (.name // "\($app)_\($k)") != "\($app)_\($k)" then "volume \($k): a name of its own (\(.name))"
   else empty end),
  (if (.driver // "local") != "local" then "volume \($k): driver \(.driver), not local" else empty end),
  (if (.driver_opts // {}) != {} then "volume \($k): driver_opts" else empty end)),

(.secrets // {} | to_entries[] | select(.value.file != null) | select(.value.file | inside | not)
  | "secret \(.key): the file \(.value.file), outside \($root)/"),
(.configs // {} | to_entries[] | select(.value.file != null) | select(.value.file | inside | not)
  | "config \(.key): the file \(.value.file), outside \($root)/"),

(.services // {} | to_entries[] | .key as $s | .value as $v |
  (if ($s | test("^[a-z0-9][a-z0-9_-]*$") | not)
   then "service \($s): its name is outside a-z 0-9 _ - (a dotted name would be an alias on \($app)'s network, where the shared services are)" else empty end),
  (if ($s | IN(reserved[])) then "service \($s): named after a shared service" else empty end),
  ($v | keys[] | select(IN(svc_allowed[]) or IN(svc_refused[]) | not)
    | "service \($s): \(.) is not allowed (outside the isolation allowlist: README, \"What an application's deployment does\")"),
  (if $v.build != null
   then "service \($s): build: the demo host runs the images the application's CI pushes to a registry (README.md, \"Accounts\")" else empty end),
  (if $v.network_mode != null then "service \($s): network_mode \($v.network_mode)" else empty end),
  (if $v | has("logging") then "service \($s): logging: the demo host bounds every container's logs (README, \"Accounts\")" else empty end),
  (if ($v.links // []) != [] then "service \($s): links" else empty end),
  (if ($v.external_links // []) != [] then "service \($s): external_links" else empty end),
  (if $v.container_name != null and ($v.container_name | startswith("\($app).") | not)
   then "service \($s): container_name \($v.container_name), outside \($app)." else empty end),
  ($v.networks // {} | to_entries[] | .key as $n | (.value // {}) |
    ((.aliases // [])[] | select(startswith("\($app).") | not) | "service \($s): alias \(.) on network \($n), outside \($app)."),
    (keys[] | select(. != "aliases") | "service \($s): network \($n) sets \(.), only aliases allowed")),
  (if ($v.ports // []) != []
   then "service \($s): published ports (\($v.ports | map(.published // .target | tostring) | join(", ")))" else empty end),
  (if $v.privileged == true then "service \($s): privileged" else empty end),
  (if ($v.cap_add // []) != [] then "service \($s): cap_add \($v.cap_add | join(", "))" else empty end),
  (if ($v.devices // []) != [] then "service \($s): devices" else empty end),
  (if ($v.device_cgroup_rules // []) != [] then "service \($s): device_cgroup_rules" else empty end),
  (("pid", "ipc", "uts", "userns_mode", "cgroup") as $ns | ($v[$ns] // empty)
    | select(. == "host" or startswith("container:")) | "service \($s): \($ns) \(.)"),
  (($v.security_opt // [])[] | select(test("^no-new-privileges(:(true|false))?$") | not)
    | "service \($s): security_opt \(.) (only no-new-privileges)"),
  (($v.volumes_from // [])[] | "service \($s): volumes_from \(.)"),
  (($v.volumes // [])[] | select(.type == "bind") |
    if (.source // "") == $root then "service \($s): a bind mount of the staging root \($root) itself"
    elif ((.source // "") | inside | not) then "service \($s): a bind mount of \(.source), outside \($root)/"
    elif .read_only != true then "service \($s): a read-write bind mount of \(.source) (a bind mount must be read-only: add :ro)"
    else empty end),
  (if ($v.deploy.resources.reservations.devices // []) != []
   then "service \($s): deploy reserves host devices" else empty end),
  (if $v.deploy != null then ($v.deploy | keys[] | select(IN(deploy_allowed[]) | not)
    | "service \($s): deploy.\(.) is not allowed") else empty end))
JQ
)

# The model refused, before any container starts, when it leaves the application's isolation
check_model() {
  local refusals
  if ! refusals=$(jq -r --arg app "$app" --arg root "$staging" "$CHECKS" "$model"); then
    fail "the model of $source_dir/compose.yml can't be checked (above): refused"
  fi
  if [ -n "$refusals" ]; then
    printf '%s\n' "$refusals" | sed 's/^/c4-app: refused: /' >&2
    fail "$source_dir/compose.yml leaves the application's isolation (above): nothing was started (README.md, \"What an application's deployment does\")"
  fi
}

# The host's bound on every container's logs: compose.yml's x-logging, as compose writes it
LOG_BOUND='{"driver":"json-file","options":{"max-size":"10m","max-file":"3"}}'

# The checked model's every service gets LOG_BOUND
bound_logs() {
  rewrite_model "$model" --argjson bound "$LOG_BOUND" '.services[]?.logging = $bound' \
    || fail "the model's logs couldn't be bounded (jq, above)"
}

# root's docker compose, on the model only (no .env read again: the model is interpolated already)
compose() {
  docker compose --project-directory "$staging" -p "$app" -f "$model" --env-file /dev/null "$@"
}

# A path the application gives, relative to ~/<application>/, in the root-only snapshot (snapshot_src
# runs first): register-app.sh reads it there, where no container can rewrite it
staged_path() { # <path>
  local resolved
  case "$1" in
    '' | /*) fail "'$1': a path relative to ~/$app/ is expected" ;;
  esac
  resolved=$(realpath -m -- "$snap_src/$1")
  case "$resolved" in
    "$snap_src"/*) printf '%s' "$resolved" ;;
    *) fail "$1 is outside ~/$app/: refused" ;;
  esac
}

# The value of KEY in the snapshot .env, read as data as compose reads it: the value the
# application's containers get (registry.sh's dotenv_value: "$$" is a "$", " #" starts a comment)
env_value() { dotenv_value "$snap_src/.env" "$1"; }

cmd_pull() {
  local registry="" user="" config status=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --registry) [ $# -ge 2 ] || usage; registry=$2; shift 2 ;;
      --registry-user) [ $# -ge 2 ] || usage; user=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  copy_in
  read_model
  # root's compose never runs an unchecked model, for any command (compose pull reads it, and would
  # run a provider's own fetch)
  check_model
  # compose's project directory; pulling changes nothing the containers mount
  staging_dir
  if [ -z "$registry" ]; then
    compose pull --quiet
    return
  fi
  [[ $registry =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || fail "--registry takes a registry's host name, not '$registry'"
  [[ $user =~ ^[A-Za-z0-9._-]+$ ]] || fail "--registry needs --registry-user <user>"
  # the token, on stdin, into a configuration of its own: never in root's ~/.docker
  config=$(mktemp -d)
  if DOCKER_CONFIG=$config docker login "$registry" -u "$user" --password-stdin > /dev/null; then
    DOCKER_CONFIG=$config compose pull --quiet || status=$?
  else
    status=1
  fi
  rm -rf "$config"
  return "$status"
}

cmd_register() {
  local args=() var value
  copy_in
  snapshot_src
  while [ $# -gt 0 ]; do
    case "$1" in
      --realm | --themes | --proxy)
        [ $# -ge 2 ] || usage
        value=$(staged_path "$2") || exit 1
        args+=("$1" "$value")
        shift 2
        ;;
      --rabbitmq-user)
        [ $# -ge 2 ] || usage
        args+=("$1" "$2")
        shift 2
        ;;
      --rabbitmq-password-env)
        # the password, from the application's .env, under a name of c4-app's: the application's
        # variable name never reaches root's environment
        [ $# -ge 2 ] || usage
        var=$2
        [[ $var =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail "--rabbitmq-password-env takes a variable name, not '$var'"
        value=$(env_value "$var") || fail "$var of ~/$app/.env is refused (above)"
        [ -n "$value" ] || fail "$var is not set in ~/$app/.env"
        export C4_APP_RABBITMQ_PASSWORD=$value
        args+=(--rabbitmq-password-env C4_APP_RABBITMQ_PASSWORD)
        shift 2
        ;;
      --reset-realms)
        args+=("$1")
        shift
        ;;
      --app) fail "the application is the account's own ($app): no --app" ;;
      *) fail "unknown option $1 (register takes --realm, --themes, --proxy, --rabbitmq-user, --rabbitmq-password-env, --reset-realms)" ;;
    esac
  done
  bash "$STACK/register-app.sh" --app "$app" "${args[@]}" < /dev/null
}

# A database's dump, run in its own container: a fixed script, its user and database read there
DUMP='pg_dump --lock-wait-timeout=120s -U "${POSTGRES_USER:-postgres}" -d "${POSTGRES_DB:-${POSTGRES_USER:-postgres}}" -Fc'
# A volume's copy: the stack's database image, no network, read-only, tar's 4 capabilities (fact d)
THROWAWAY=(--rm --pull never --network none --read-only --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE
  --cap-add FOWNER --cap-add FSETID --security-opt no-new-privileges --log-driver none)

iec() { numfmt --to=iec-i --suffix=B "$1"; }
sorted() { [ $# -eq 0 ] || printf '%s\n' "$@" | sort; }
is_stamp() { [[ $1 =~ ^[0-9]{8}-[0-9]{6}$ ]]; }

# The application's backup directory, without an interrupted backup
backup_dir() {
  install -d -m 0755 -o root -g root "$BACKUP_ROOT"
  install -d -m 0750 -o root -g "$app" "$backups"
  rm -rf "$backups"/*.partial
}

# PA-04, after a backup or a restore that succeeded: the backups older than 7 days, but the newest
prune() {
  local cutoff newest= entry name
  cutoff=$(date -u -d "$KEEP_DAYS days ago" +%Y%m%d-%H%M%S)
  for entry in "$backups"/*; do
    name=${entry##*/}
    ! is_stamp "$name" || newest=$name
  done
  for entry in "$backups"/*; do
    name=${entry##*/}
    if is_stamp "$name" && [[ $name < $cutoff ]] && [ "$name" != "$newest" ]; then
      rm -rf "$entry"
      echo "c4-app: backup $name of $app removed: older than $KEEP_DAYS days"
    fi
  done
}

# The image the volumes are copied with: the stack's own database's, on the host, with GNU tar
stack_image() {
  local state
  state=$(docker inspect -f '{{.State.Running}} {{.Image}}' c4-infra.keycloak-db 2> /dev/null) || state=
  [[ $state =~ ^true\ (sha256:[0-9a-f]{64})$ ]] \
    || fail "c4-infra.keycloak-db doesn't run: its image copies the volumes, refused (the stack's deployment starts it)"
  printf '%s' "${BASH_REMATCH[1]}"
}

# The project's containers and volumes (compose's own label, their names), what its services declare
declare -A dump_of=() volumes_of=() mounters_of=() service_of=()
running=()
unbacked=()
nothing=
tar_image=
select_items() { # backup | restore
  local ids infos name state service kind mounts volume
  local -A project_volume=() kind_of=() count_of=() container_of=() running_of=() mounts_of=() covered=()
  ids=$(docker volume ls -q --filter "label=com.docker.compose.project=$app") || fail "docker volume ls failed (above)"
  for volume in $ids; do
    if [[ $volume == "${app}_"* && ${volume#"${app}_"} =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
      project_volume[$volume]=1
    fi
  done
  ids=$(docker ps -aq --no-trunc --filter "label=com.docker.compose.project=$app") || fail "docker ps failed (above)"
  infos=
  if [ -n "$ids" ]; then
    # one line per container, each field a JSON string: no label's tab or newline splits it
    # shellcheck disable=SC2086 # container ids: hexadecimal
    infos=$(docker inspect $ids | jq -r '.[] | [.Name, (.State.Running | tostring),
      ((.Config.Labels // {})["com.docker.compose.service"] // ""), ((.Config.Labels // {})["c4-infra.backup"] // ""),
      ([.Mounts[]? | select(.Type == "volume") | .Name] | join(" "))] | map(tojson) | join("\t")') \
      || fail "docker inspect failed (above)"
  fi
  while IFS=$'\t' read -r name state service kind mounts; do
    [ -n "$name" ] || continue
    name=${name:1:-1} state=${state:1:-1} service=${service:1:-1} mounts=${mounts:1:-1}
    [[ $name == "/$app."* || $name == "/$app-"* ]] || continue
    name=${name#/}
    [[ $service =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail "container $name: service '$(printf %q "$service")', not a service's name: refused"
    service_of[$name]=$service
    [ "$state" != true ] || running+=("$name")
    case "$kind" in
      '""') kind= ;;
      '"postgres"' | '"volumes"') kind=${kind:1:-1} ;;
      *) fail "service $service: c4-infra.backup '$(printf %q "$(jq -r . <<< "$kind")")': postgres or volumes" ;;
    esac
    for volume in $mounts; do
      [ -n "${project_volume[$volume]:-}" ] || continue
      mounters_of[$volume]+="$name "
      mounts_of[$service]+="$volume "
    done
    [ -n "$kind" ] || continue
    kind_of[$service]=$kind
    count_of[$service]=$((${count_of[$service]:-0} + 1))
    container_of[$service]=$name
    running_of[$service]=$state
  done <<< "$infos"
  if [ ${#service_of[@]} -eq 0 ]; then
    nothing="$app has no container: nothing to back up"
    return
  fi
  if [ "$1" = backup ] && [ ${#running[@]} -eq 0 ]; then
    nothing="no container of $app runs: nothing to back up"
    return
  fi
  for service in $(sorted "${!kind_of[@]}"); do
    [ "${count_of[$service]}" -eq 1 ] || fail "service $service: ${count_of[$service]} containers (replicas), refused: a backup takes one"
    if [ "${kind_of[$service]}" = postgres ]; then
      [ "${running_of[$service]}" = true ] \
        || fail "service $service: c4-infra.backup postgres, its container ${container_of[$service]} doesn't run: refused"
      dump_of[$service]=${container_of[$service]}
    elif [ -z "${mounts_of[$service]:-}" ]; then
      fail "service $service is declared volumes but mounts no named volume of $app: refused"
    fi
  done
  # a volume once, under the first volumes service mounting it; a database's others are in its dump
  for service in $(sorted "${!kind_of[@]}"); do
    [ "${kind_of[$service]}" = volumes ] || continue
    # shellcheck disable=SC2086 # volume names, checked: no space, no glob
    for volume in $(sorted ${mounts_of[$service]}); do
      [ -z "${covered[$volume]:-}" ] || continue
      volumes_of[$service]+="$volume "
      covered[$volume]=1
    done
  done
  for service in "${!dump_of[@]}"; do
    for volume in ${mounts_of[$service]:-}; do
      covered[$volume]=1
    done
  done
  for volume in $(sorted "${!project_volume[@]}"); do
    [ -n "${covered[$volume]:-}" ] || unbacked+=("$volume")
  done
  if [ ${#dump_of[@]} -eq 0 ] && [ ${#volumes_of[@]} -eq 0 ]; then
    nothing="$app declares no data to back up (label c4-infra.backup on a service: postgres or volumes)"
    return
  fi
  [ ${#volumes_of[@]} -eq 0 ] || tar_image=$(stack_image)
}

# PA-05: the bytes left above the larger of 5 GiB and 10 % of the disk; none refuses the backup
room_above_floor() { # [<what is refused>]
  local what=${1:-backup of $app} free size floor
  read -r free size <<< "$(df -P -B1 "$BACKUP_ROOT" | awk 'NR == 2 { print $4, $2 }')"
  [[ $free =~ ^[0-9]+$ && $size =~ ^[0-9]+$ ]] || fail "the free space of $BACKUP_ROOT can't be read (df, above)"
  floor=$((size / 10))
  [ "$floor" -ge "$FLOOR_MIN" ] || floor=$FLOOR_MIN
  [ "$free" -gt "$floor" ] \
    || fail "$what refused: $(iec "$free") free on $BACKUP_ROOT, under the floor of $(iec "$floor") (5 GiB, or 10 % of $(iec "$size")): nothing of it is kept, the earlier backups stay"
  echo $((free - floor))
}

# An item into its file, cut at the room above the floor: reaching it, a timeout, a failure refuse
write_item() { # <file> <command>…
  local file=$1 room size
  local -a status
  shift
  room=$(room_above_floor)
  set +e
  timeout "$ITEM_TIMEOUT" "$@" < /dev/null | head -c "$room" > "$partial/$file"
  status=("${PIPESTATUS[@]}")
  set -e
  size=$(stat -c %s "$partial/$file")
  [ "$size" -lt "$room" ] \
    || fail "$file reached the $(iec "$room") left above the floor on $BACKUP_ROOT: backup of $app refused, nothing of it is kept, the earlier backups stay"
  [ "${status[0]}" -ne 124 ] || fail "$file didn't end within $ITEM_TIMEOUT s: no backup of $app kept"
  [ "${status[0]}" -eq 0 ] && [ "${status[1]}" -eq 0 ] || fail "$file failed (above): no backup of $app kept"
}

# The containers no longer to start again on the way out
untrack() { # <container>…
  local name gone
  local -a kept=()
  for name in "${stopped[@]}"; do
    for gone in "$@"; do
      [ "$name" != "$gone" ] || continue 2
    done
    kept+=("$name")
  done
  stopped=("${kept[@]}")
}

# The running containers that mount these volumes, stopped (started again on the way out); sets group
group=()
stop_mounters() { # <volume>…
  local volume name
  local -A seen=()
  group=()
  for volume in "$@"; do
    for name in ${mounters_of[$volume]:-}; do
      [ -z "${seen[$name]:-}" ] || continue
      seen[$name]=1
      if [ "$(docker inspect -f '{{.State.Running}}' "$name")" = true ]; then
        group+=("$name")
      fi
    done
  done
  [ ${#group[@]} -gt 0 ] || return 0
  stopped+=("${group[@]}")
  docker stop "${group[@]}" > /dev/null || fail "${group[*]} could not be stopped (above)"
}

# Running, healthy where checked, or done (exited 0) within 300 s; the others named, status 1
wait_running() { # <container>…
  local deadline=$((SECONDS + 300)) name state
  for name in "$@"; do
    while :; do
      state=$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$name") \
        || { echo "c4-app: $name can't be inspected (above)" >&2; return 1; }
      case "$state" in
        'running '*' ' | 'running '*' healthy' | 'exited 0 '*) break ;;
        exited* | dead*) echo "c4-app: $name stopped once started ($state)" >&2; return 1 ;;
      esac
      [ "$SECONDS" -lt "$deadline" ] \
        || { echo "c4-app: $name isn't running and healthy 300 s after its start ($state)" >&2; return 1; }
      sleep 1
    done
  done
}

# Stopped containers started again in their depends_on order (compose's label), each layer waited for
start_again() { # <container>…
  local name dep ready label
  local -a left=("$@") layer next deps
  local -A pending=()
  for name in "$@"; do
    pending[${service_of[$name]}]=1
  done
  while [ ${#left[@]} -gt 0 ]; do
    layer=() next=()
    for name in "${left[@]}"; do
      ready=1
      label=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.depends_on"}}' "$name")
      IFS=, read -ra deps <<< "$label"
      for dep in "${deps[@]}"; do
        dep=${dep%%:*}
        if [[ $dep =~ ^[a-z0-9][a-z0-9_-]*$ ]] && [ -n "${pending[$dep]:-}" ]; then
          ready=
        fi
      done
      if [ -n "$ready" ]; then layer+=("$name"); else next+=("$name"); fi
    done
    # a cycle: the rest at once
    if [ ${#layer[@]} -eq 0 ]; then
      layer=("${next[@]}") next=()
    fi
    docker start "${layer[@]}" > /dev/null || fail "${layer[*]} could not be started again (above)"
    untrack "${layer[@]}"
    wait_running "${layer[@]}" || return 1
    for name in "${layer[@]}"; do
      unset "pending[${service_of[$name]}]"
    done
    left=("${next[@]}")
  done
}

# One backup into <stamp>.partial, renamed once complete: dumps hot, then volumes cold; sets stamp
take_backup() {
  local service volume file summary=
  local -a written=() unwell=()
  stamp=$(date -u +%Y%m%d-%H%M%S)
  while [ -e "$backups/$stamp" ]; do
    sleep 1
    stamp=$(date -u +%Y%m%d-%H%M%S)
  done
  partial=$backups/$stamp.partial
  install -d -m 0750 -o root -g "$app" "$partial"
  for service in $(sorted "${!dump_of[@]}"); do
    write_item "$service.dump" docker exec "${dump_of[$service]}" sh -c "$DUMP"
    written+=("$service.dump")
  done
  for service in $(sorted "${!volumes_of[@]}"); do
    # shellcheck disable=SC2086 # volume names, checked: no space, no glob
    stop_mounters ${volumes_of[$service]}
    for volume in ${volumes_of[$service]}; do
      file=$service.${volume#"${app}_"}.tar
      write_item "$file" docker run "${THROWAWAY[@]}" --mount "type=volume,src=$volume,dst=/data" --entrypoint tar "$tar_image" \
        --sparse --numeric-owner -cpf - -C /data .
      written+=("$file")
    done
    start_again "${group[@]}" || unwell+=("${group[@]}")
  done
  room_above_floor > /dev/null
  chown -R "root:$app" "$partial"
  chmod 0640 "$partial"/*
  mv "$partial" "$backups/$stamp"
  partial=
  for file in "${written[@]}"; do
    summary+="${summary:+, }$file ($(iec "$(stat -c %s "$backups/$stamp/$file")"))"
  done
  echo "c4-app: backup $stamp of $app: $summary"
  for volume in "${unbacked[@]}"; do
    echo "c4-app: not backed up: $volume"
  done
  [ ${#unwell[@]} -eq 0 ] \
    || fail "backup $stamp of $app kept, but ${unwell[*]} didn't all run again within 300 s once started (see docker ps)"
}

cmd_backup() {
  [ $# -eq 0 ] || usage
  read_limits || fail "$limits_refusal"
  backup_dir
  select_items backup
  if [ -n "$nothing" ]; then
    echo "c4-app: $nothing"
    return 0
  fi
  take_backup
  prune
}

# A database recreated empty, then its dump restored, in its container: names reach psql as variables
RECREATE='db=${POSTGRES_DB:-${POSTGRES_USER:-postgres}}
maintenance=postgres
[ "$db" != postgres ] || maintenance=template1
exec psql -q -v ON_ERROR_STOP=1 -U "${POSTGRES_USER:-postgres}" -d "$maintenance" -v db="$db" -v owner="${POSTGRES_USER:-postgres}"'
RESTORE='exec pg_restore --exit-on-error -U "${POSTGRES_USER:-postgres}" -d "${POSTGRES_DB:-${POSTGRES_USER:-postgres}}"'

list_backups() {
  local entry name found=
  for entry in "$backups"/*; do
    name=${entry##*/}
    [ -d "$entry" ] && is_stamp "$name" || continue
    [ -n "$found" ] || echo "c4-app: the backups of $app, the latest last (sudo c4-app restore <stamp> --yes restores one):"
    found=1
    echo "  $name  $(iec "$(du -sb "$entry" | cut -f1)")"
  done
  [ -n "$found" ] || echo "c4-app: $app has no backup (sudo c4-app backup takes one)"
}

# Each file of a backup matched to a declared database or volume, then read whole; sets dump_into, tar_into
declare -A dump_into=() tar_into=()
match_backup() { # <stamp>
  local entry file service volume
  local -A copied=()
  for service in "${!volumes_of[@]}"; do
    # shellcheck disable=SC2086 # volume names, checked: no space, no glob
    for volume in ${volumes_of[$service]}; do
      copied[$volume]=1
    done
  done
  for entry in "$backups/$1"/*; do
    [ -e "$entry" ] || continue
    file=${entry##*/}
    if [[ $file =~ ^([a-z0-9][a-z0-9_-]*)\.dump$ ]]; then
      service=${BASH_REMATCH[1]}
      [ -n "${dump_of[$service]:-}" ] \
        || fail "$file of backup $1: $app has no running service $service declared c4-infra.backup postgres: restore refused"
      dump_into[$file]=${dump_of[$service]}
    elif [[ $file =~ ^[a-z0-9][a-z0-9_-]*\.([A-Za-z0-9][A-Za-z0-9_.-]*)\.tar$ ]]; then
      volume=${app}_${BASH_REMATCH[1]}
      [ -n "${copied[$volume]:-}" ] \
        || fail "$file of backup $1: $volume is no volume of a service $app declares c4-infra.backup volumes: restore refused"
      tar_into[$file]=$volume
    else
      fail "backup $1 holds $(printf %q "$file"), neither a dump nor a volume's archive: restore refused"
    fi
  done
  [ ${#dump_into[@]} -gt 0 ] || [ ${#tar_into[@]} -gt 0 ] || fail "backup $1 of $app is empty: restore refused"
  for file in "${!dump_into[@]}"; do
    docker exec -i "${dump_into[$file]}" pg_restore -f /dev/null < "$backups/$1/$file" \
      || fail "$file of backup $1 can't be read whole (pg_restore, above): restore refused, nothing changed"
  done
  for file in "${!tar_into[@]}"; do
    docker run -i "${THROWAWAY[@]}" --entrypoint tar "$tar_image" -tf - < "$backups/$1/$file" > /dev/null \
      || fail "$file of backup $1 can't be read whole (tar, above): restore refused, nothing changed"
  done
}

# PA-06 A: the checks, all but the databases stopped, the state before backed up, the items restored
cmd_restore() {
  local wanted= yes= file name
  local -a stop=()
  local -A database=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1 ;;
      *) [ -z "$wanted" ] || usage; wanted=$1 ;;
    esac
    shift
  done
  if [ -z "$wanted" ]; then
    [ -z "$yes" ] || usage
    list_backups
    return 0
  fi
  is_stamp "$wanted" \
    || fail "no backup $(printf %q "$wanted") of $app: a backup is named by its stamp, YYYYMMDD-HHMMSS (sudo c4-app restore lists them)"
  [ -d "$backups/$wanted" ] || fail "no backup $wanted of $app (sudo c4-app restore lists them)"
  [ -n "$yes" ] \
    || fail "restore $wanted replaces $app's databases and volumes with that backup's, once the state before is backed up: sudo c4-app restore $wanted --yes"
  read_limits || fail "$limits_refusal"
  select_items restore
  [ -z "$nothing" ] || fail "$nothing: restore refused"
  match_backup "$wanted"
  room_above_floor "restore of $app (the state before backed up first)" > /dev/null

  backup_dir
  restoring=$wanted
  for name in "${dump_of[@]}"; do
    database[$name]=1
  done
  for name in "${running[@]}"; do
    [ -n "${database[$name]:-}" ] || stop+=("$name")
  done
  stopped+=("${stop[@]}")
  [ ${#stop[@]} -eq 0 ] || docker stop "${stop[@]}" > /dev/null || fail "${stop[*]} could not be stopped (above)"
  take_backup
  safety=$stamp
  altered=1
  for file in $(sorted "${!dump_into[@]}"); do
    printf '%s\n' 'DROP DATABASE IF EXISTS :"db" WITH (FORCE);' 'CREATE DATABASE :"db" OWNER :"owner";' \
      | docker exec -i "${dump_into[$file]}" sh -c "$RECREATE" \
      || fail "${dump_into[$file]}: its database could not be recreated (above)"
    docker exec -i "${dump_into[$file]}" sh -c "$RESTORE" < "$backups/$wanted/$file" \
      || fail "${dump_into[$file]}: $file could not be restored (above)"
  done
  # a database that mounts a restored volume stops too
  # shellcheck disable=SC2046 # volume names, checked: no space, no glob
  stop_mounters $(sorted "${tar_into[@]}")
  for file in $(sorted "${!tar_into[@]}"); do
    docker run -i "${THROWAWAY[@]}" --mount "type=volume,src=${tar_into[$file]},dst=/data" --entrypoint sh "$tar_image" \
      -c 'find /data -mindepth 1 -delete && tar --numeric-owner -xpf - -C /data' < "$backups/$wanted/$file" \
      || fail "${tar_into[$file]}: $file could not be restored (above)"
  done
  altered=
  restoring=
  prune
  echo "c4-app: backup $wanted of $app restored; the state before it is backup $safety"
  start_again "${stopped[@]}" \
    || fail "backup $wanted of $app restored, but its containers didn't all run again within 300 s (see docker ps)"
}

command=${1:-}
[ $# -eq 0 ] || shift
case "$command" in
  pull) cmd_pull "$@" ;;
  up)
    [ $# -eq 0 ] || usage
    copy_in
    read_model
    # the file compose runs is the one checked: root's, outside anything a container may mount
    check_model
    bound_logs
    bash "$STACK/networks.sh" ensure "$app" < /dev/null
    pull_missing
    place_copy
    compose up -d --wait --remove-orphans
    ;;
  down)
    [ $# -eq 0 ] || usage
    # by the project's name, from / (no compose file there): compose finds its containers and
    # networks by their labels, and runs nothing a file declares (a provider's down, pre_stop hooks)
    docker compose -p "$app" down --remove-orphans
    ;;
  register) cmd_register "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  *) usage ;;
esac
