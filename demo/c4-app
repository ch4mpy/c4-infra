#!/bin/bash
# The one command an application's account on the demo host runs as root (intent 0002): the account
# is in the group c4-apps, outside the docker group, and /etc/sudoers.d/c4-infra
# (demo/vps-bootstrap.sh) lets that group run this file, which demo/deploy.sh installs root-owned as
# /usr/local/sbin/c4-app. The application is the account that runs it (SUDO_USER), never an
# argument:
#
#   sudo c4-app pull [--registry <host> --registry-user <user>]
#                                   pulls the images of the application's compose project; with
#                                   --registry, logs in first with the token read on stdin, in a
#                                   temporary Docker configuration removed at once
#   sudo c4-app up                  starts the project, or brings it up to date, and waits until it
#                                   runs (healthy where it has a healthcheck); refuses, before any
#                                   container starts, a project that leaves its isolation (below),
#                                   then makes sure of the application's network c4-infra.<application>
#                                   (networks.sh ensure)
#   sudo c4-app down                stops and removes the project's containers (its volumes stay)
#   sudo c4-app register <option>…  bash /home/c4-infra/c4-infra/register-app.sh --app <application>
#                                   with register-app.sh's options (README.md) but --app: paths are
#                                   relative to ~/<application>/, and --rabbitmq-password-env <VAR>
#                                   takes VAR from ~/<application>/.env
#
# Each command works on a copy of ~/<application>/<application>/ (sent there by the application's
# workflow), read as the application and written by root into /var/lib/c4-apps/<application>/
# (root:<application>, mode 0750: the application reads it, never writes it); a symbolic link or a
# special file in it is refused. That copy is only the containers' mount sources at run time; what
# root itself reads — the compose model, and (for register) the realm, routes and theme files — is a
# fresh root-only snapshot in /var/lib/c4-apps/.run.<application>/ (mode 0700 root:root), outside
# anything a container may mount, taken once the checks have passed and used from there. The compose
# model is read as the application (`docker compose config`: no daemon, and no file its account can't
# read, such as another application's env_file) into .run.<application>/model.json, which root's
# `docker compose` runs as the project <application>; root reads nothing of the application's copy on
# its behalf.
#
# `up`, `down` and `pull` all check that model first, before root's compose touches it (intent 0007,
# REQ-9): compose runs a provider's and a hook's executables, so an unchecked model must never reach
# it. The check is an allowlist — the top-level keys, the service keys, and the sub-keys/values of
# the nested objects that can escape (build, deploy, security_opt, volumes and networks entries) that
# an application may use; anything else is refused, naming the service (or network/volume) and the
# key (CHECKS below; the list is also in README.md, "What an application's deployment does"). What is
# allowed, in short:
#   - top level: services, networks, volumes, secrets, configs;
#   - a service: its image/build, container_name and network aliases under <application>., its
#     command/entrypoint/environment/env_file, expose (never ports), its own networks and named
#     volumes, read-only bind mounts inside /var/lib/c4-apps/<application>/, healthcheck, depends_on,
#     resource limits, and the usual hardening (read_only, cap_drop, user, tmpfs, init,
#     security_opt: no-new-privileges). A service name is [a-z0-9_-]+ (no dot: a dotted name would
#     be an alias on the shared network).
#   - refused with their own clearer message: a service named after a shared service (keycloak,
#     mailpit, rabbitmq, grafana-lgtm, reverse-proxy, keycloak-db) or the shared host (INFRA_HOST); a
#     published port; privileged, cap_add, devices, device_cgroup_rules; network_mode, links,
#     external_links, volumes_from; pid/ipc/uts/userns_mode/cgroup set to host or another container;
#     a read-write bind mount, or one of the staging root or outside it (the Docker socket, another
#     application's files…); an external network or volume, one with a name or driver of its own, or
#     driver_opts; a build context or Dockerfile outside the staging tree.
#   - refused by the allowlist (not an application's to set): use_api_socket, post_start/pre_stop
#     hooks, a provider service, build.network/privileged/entitlements/ssh, and anything else not
#     listed above.
#
# A registration runs with the shared stack's registration credential, in
# /home/c4-infra/c4-infra/.env (mode 600, the c4-infra account's), which only root reads; it touches
# only what the application's registry entry assigns to it (register-app.sh).
set -euo pipefail
umask 027
cd /

# Nothing of the caller's environment: sudo already resets it, this keeps only what follows
for name in $(compgen -e); do
  case "$name" in
    SUDO_USER) ;;
    *) unset "$name" 2> /dev/null || true ;;
  esac
done
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LC_ALL=C.UTF-8

STACK=/home/c4-infra/c4-infra
STAGING_ROOT=/var/lib/c4-apps

fail() {
  echo "c4-app: $*" >&2
  exit 1
}
usage() {
  cat >&2 <<'EOF'
Usage, from an application's account:
  sudo c4-app pull [--registry <host> --registry-user <user>]   (token on stdin)
  sudo c4-app up
  sudo c4-app down
  sudo c4-app register [--realm <file>]... [--themes <dir>] [--proxy <routes file>]
                       [--rabbitmq-user <user> --rabbitmq-password-env <VAR of .env>] [--reset-realms]
EOF
  exit 2
}

[ "$(id -u)" -eq 0 ] || fail "runs as root, through sudo: sudo c4-app <command>"
app=${SUDO_USER:-}
case "$app" in
  '') fail "runs through sudo, from an application's account: sudo c4-app <command>" ;;
  root | c4-infra) fail "$app is not an application's account" ;;
esac
[[ $app =~ ^[a-z][a-z0-9-]*$ ]] || fail "$app is not an application's name"

# The application is in the shared stack's registry (never another file: REGISTRY_FILE is unset with
# the rest of the environment)
# shellcheck source=../registry.sh
source "$STACK/registry.sh"
registry_check || fail "the shared stack's registry ($STACK/registry.txt) is invalid (above)"
registry_entry "$app" || fail "$app is not in the shared stack's registry ($STACK/registry.txt)"

source_dir=/home/$app/$app
staging=$STAGING_ROOT/$app
# root-only, outside anything a container may mount (not inside $staging): the model root's compose
# runs, and the snapshot of the inputs root reads for register
snap=$STAGING_ROOT/.run.$app
snap_src=$snap/src
model=$snap/model.json
[ -d "$source_dir" ] || fail "$source_dir is missing: the application's workflow sends its files there first"

# One command at a time per application
install -d -m 0755 -o root -g root "$STAGING_ROOT"
exec 9> "$STAGING_ROOT/.$app.lock"
flock -w 600 9 || fail "another c4-app command of $app is still running"

# The staging copy: read as the application (what its account can't read isn't copied), checked for
# symbolic and special files, then synchronized into the staging directory (0750 root:<app>, the
# containers' mount sources; the application reads it, never writes it). The root-only snapshot
# directory is (re)created empty here, holding nothing the application put there.
stage() {
  local incoming=$STAGING_ROOT/.$app.incoming found
  rm -rf "$incoming" "$snap"
  install -d -m 0700 -o root -g root "$incoming"
  if ! runuser -u "$app" -- tar -C "$source_dir" -cf - . \
    | tar -C "$incoming" -xf - --no-same-owner --no-same-permissions; then
    rm -rf "$incoming"
    fail "$source_dir could not be copied (above)"
  fi
  # (head may close the pipe early: its status, not find's)
  found=$(find "$incoming" -mindepth 1 ! -type f ! -type d -printf '%P\n' | head -n 5 || true)
  if [ -n "$found" ]; then
    rm -rf "$incoming"
    fail "$source_dir holds a symbolic link or a special file, refused: ${found//$'\n'/, }"
  fi
  chown -R "root:$app" "$incoming"
  chmod -R u+rwX,g+rX,g-w,o-rwx "$incoming"
  install -d -m 0750 -o root -g "$app" "$staging"
  rsync -a --delete "$incoming/" "$staging/"
  rm -rf "$incoming"
  # the snapshot directory root reads from: root-only, no container may mount it (not inside $staging)
  install -d -m 0700 -o root -g root "$snap"
}

# A root-only snapshot of the staging tree, taken after stage()'s checks: register reads the realm,
# routes and theme files from here, which no container can rewrite (symlink-free: stage refused them)
snapshot_src() {
  rm -rf "$snap_src"
  cp -a "$staging" "$snap_src"
}

# The compose model, read as the application, into the root-only model file root's compose runs. The
# redirection and the mv are root's, into $snap (root-only): no container can plant a symlink there.
read_model() {
  local next=$model.new
  [ -f "$staging/compose.yml" ] || fail "$source_dir/compose.yml is missing"
  rm -f "$model" "$next"
  if ! runuser -u "$app" -- env -i PATH="$PATH" HOME="/home/$app" \
    docker compose --project-directory "$staging" -p "$app" -f "$staging/compose.yml" config --format json > "$next"; then
    rm -f "$next"
    fail "docker compose config refuses $source_dir/compose.yml (above)"
  fi
  chown root:root "$next"
  chmod 0640 "$next"
  mv "$next" "$model"
}

# What leaves the application's isolation: an allowlist (the header's list; README's too). The keys
# an application may set — top-level, per service, and the sub-keys/values of the nested objects that
# can escape (build, deploy, security_opt, volumes and networks entries) — are listed; anything else
# is refused, naming the service (or network/volume) and the key. The escapes a specific message
# reads more clearly keep that message. One line per refusal.
CHECKS=$(cat <<'JQ'
def inside: . as $p | (($p == $root) or ($p | startswith($root + "/"))) and (($p | test("(^|/)[.][.](/|$)")) | not);
def remote: test("^(https?://|git://|git@|docker-image://|service:)");
def reserved: ["keycloak", "mailpit", "rabbitmq", "grafana-lgtm", "reverse-proxy", "keycloak-db"]
  + (if $host == "" then [] else [$host] end);
def svc_allowed: [
  "image", "container_name", "command", "entrypoint", "environment", "env_file", "expose",
  "networks", "volumes", "depends_on", "healthcheck", "restart", "labels", "annotations", "user",
  "working_dir", "hostname", "read_only", "cap_drop", "init", "tmpfs", "stop_grace_period",
  "stop_signal", "stop_timeout", "mem_limit", "mem_reservation", "memswap_limit", "cpus", "cpuset",
  "cpu_shares", "shm_size", "pids_limit", "ulimits", "deploy", "build", "secrets", "configs",
  "pull_policy", "platform", "stdin_open", "tty", "security_opt"];
def svc_refused: ["network_mode", "links", "external_links", "ports", "privileged", "cap_add",
  "devices", "device_cgroup_rules", "pid", "ipc", "uts", "userns_mode", "cgroup", "volumes_from"];
def top_allowed: ["name", "services", "networks", "volumes", "secrets", "configs"];
def build_allowed: ["context", "dockerfile", "additional_contexts", "args", "target", "labels",
  "tags", "cache_from", "no_cache", "pull", "platforms"];
def deploy_allowed: ["resources", "restart_policy", "labels", "replicas", "update_config",
  "rollback_config", "placement", "mode", "endpoint_mode"];

(keys[] | select(IN(top_allowed[]) | not)
  | "top-level key \(.): not allowed (an application provides services, networks, volumes, secrets, configs)"),

(.networks // {} | to_entries[] | .key as $k | (.value // {}) |
  (if .external == true then
    (if .name != "c4-infra.\($app)" then "network \($k): external, and not c4-infra.\($app) (\(.name))" else empty end)
  else
    (if (.name // "\($app)_\($k)") != "\($app)_\($k)" then "network \($k): a name of its own (\(.name))" else empty end),
    (if (.driver // "bridge") != "bridge" then "network \($k): driver \(.driver), not bridge" else empty end)
  end),
  (if (.driver_opts // {}) != {} then "network \($k): driver_opts" else empty end)),

(.volumes // {} | to_entries[] | .key as $k | (.value // {}) |
  (if .external == true then "volume \($k): external (\(.name // $k))"
   elif (.name // "\($app)_\($k)") != "\($app)_\($k)" then "volume \($k): a name of its own (\(.name))"
   else empty end),
  (if (.driver // "local") != "local" then "volume \($k): driver \(.driver), not local" else empty end),
  (if (.driver_opts // {}) != {} then "volume \($k): driver_opts" else empty end)),

(.secrets // {} | to_entries[] | select(.value.file != null) | select(.value.file | inside | not)
  | "secret \(.key): the file \(.value.file), outside \($root)/"),
(.configs // {} | to_entries[] | select(.value.file != null) | select(.value.file | inside | not)
  | "config \(.key): the file \(.value.file), outside \($root)/"),

(.services // {} | to_entries[] | .key as $s | .value as $v |
  (if ($s | test("^[a-z0-9][a-z0-9_-]*$") | not)
   then "service \($s): its name is outside a-z 0-9 _ - (a dotted name would be an alias on \($app)'s network, where the shared services are)" else empty end),
  (if ($s | IN(reserved[])) then "service \($s): named after a shared service" else empty end),
  ($v | keys[] | select(IN(svc_allowed[]) or IN(svc_refused[]) | not)
    | "service \($s): \(.) is not allowed (outside the isolation allowlist: README, \"What an application's deployment does\")"),
  (if $v.network_mode != null then "service \($s): network_mode \($v.network_mode)" else empty end),
  (if ($v.links // []) != [] then "service \($s): links" else empty end),
  (if ($v.external_links // []) != [] then "service \($s): external_links" else empty end),
  (if $v.container_name != null and ($v.container_name | startswith("\($app).") | not)
   then "service \($s): container_name \($v.container_name), outside \($app)." else empty end),
  ($v.networks // {} | to_entries[] | .key as $n | (.value // {}) |
    ((.aliases // [])[] | select(startswith("\($app).") | not) | "service \($s): alias \(.) on network \($n), outside \($app)."),
    (keys[] | select(. != "aliases") | "service \($s): network \($n) sets \(.), only aliases allowed")),
  (if ($v.ports // []) != []
   then "service \($s): published ports (\($v.ports | map(.published // .target | tostring) | join(", ")))" else empty end),
  (if $v.privileged == true then "service \($s): privileged" else empty end),
  (if ($v.cap_add // []) != [] then "service \($s): cap_add \($v.cap_add | join(", "))" else empty end),
  (if ($v.devices // []) != [] then "service \($s): devices" else empty end),
  (if ($v.device_cgroup_rules // []) != [] then "service \($s): device_cgroup_rules" else empty end),
  (("pid", "ipc", "uts", "userns_mode", "cgroup") as $ns | ($v[$ns] // empty)
    | select(. == "host" or startswith("container:")) | "service \($s): \($ns) \(.)"),
  (($v.security_opt // [])[] | select(test("^no-new-privileges(:(true|false))?$") | not)
    | "service \($s): security_opt \(.) (only no-new-privileges)"),
  (($v.volumes_from // [])[] | "service \($s): volumes_from \(.)"),
  (($v.volumes // [])[] | select(.type == "bind") |
    if (.source // "") == $root then "service \($s): a bind mount of the staging root \($root) itself"
    elif ((.source // "") | inside | not) then "service \($s): a bind mount of \(.source), outside \($root)/"
    elif .read_only != true then "service \($s): a read-write bind mount of \(.source) (a bind mount must be read-only: add :ro)"
    else empty end),
  (if ($v.deploy.resources.reservations.devices // []) != []
   then "service \($s): deploy reserves host devices" else empty end),
  (if $v.deploy != null then ($v.deploy | keys[] | select(IN(deploy_allowed[]) | not)
    | "service \($s): deploy.\(.) is not allowed") else empty end),
  (if $v.build != null then
     ($v.build | keys[] | select(IN(build_allowed[]) | not)
       | "service \($s): build.\(.) is not allowed (outside the isolation allowlist)"),
     (($v.build.context // empty) | select(remote | not) | select(inside | not)
       | "service \($s): build context \(.), outside \($root)/"),
     (($v.build.additional_contexts // {}) | to_entries[] | .value | select(remote | not) | select(inside | not)
       | "service \($s): build context \(.), outside \($root)/"),
     (($v.build.dockerfile // empty) as $df | ($v.build.context // $root) as $ctx |
       if ($df | startswith("/")) then (if ($df | inside) then empty else "service \($s): Dockerfile \($df), outside \($root)/" end)
       elif ($ctx | remote) or (($ctx | inside) | not) then empty
       else (($ctx + "/" + $df) | if inside then empty else "service \($s): Dockerfile \($df) resolves outside \($root)/" end) end)
   else empty end))
JQ
)

# The model refused, before any container starts, when it leaves the application's isolation
check_model() {
  local host refusals
  host=$(dotenv_value "$STACK/.env" INFRA_HOST) || fail "INFRA_HOST of $STACK/.env can't be read (above)"
  if ! refusals=$(jq -r --arg app "$app" --arg root "$staging" --arg host "$host" "$CHECKS" "$model"); then
    fail "the model of $source_dir/compose.yml can't be checked (above): refused"
  fi
  if [ -n "$refusals" ]; then
    printf '%s\n' "$refusals" | sed 's/^/c4-app: refused: /' >&2
    fail "$source_dir/compose.yml leaves the application's isolation (above): nothing was started (README.md, \"What an application's deployment does\")"
  fi
}

# root's docker compose, on the model only (no .env read again: the model is interpolated already)
compose() {
  docker compose --project-directory "$staging" -p "$app" -f "$model" --env-file /dev/null "$@"
}

# A path the application gives, relative to ~/<application>/, in the root-only snapshot (snapshot_src
# runs first): register-app.sh reads it there, where no container can rewrite it
staged_path() { # <path>
  local resolved
  case "$1" in
    '' | /*) fail "'$1': a path relative to ~/$app/ is expected" ;;
  esac
  resolved=$(realpath -m -- "$snap_src/$1")
  case "$resolved" in
    "$snap_src"/*) printf '%s' "$resolved" ;;
    *) fail "$1 is outside ~/$app/: refused" ;;
  esac
}

# The value of KEY in the snapshot .env, read as data as compose reads it: the value the
# application's containers get (registry.sh's dotenv_value: "$$" is a "$", " #" starts a comment)
env_value() { dotenv_value "$snap_src/.env" "$1"; }

cmd_pull() {
  local registry="" user="" config status=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --registry) [ $# -ge 2 ] || usage; registry=$2; shift 2 ;;
      --registry-user) [ $# -ge 2 ] || usage; user=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  stage
  read_model
  # root's compose never runs an unchecked model, for any command (compose pull reads it, and would
  # run a provider's own fetch)
  check_model
  if [ -z "$registry" ]; then
    compose pull --quiet
    return
  fi
  [[ $registry =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || fail "--registry takes a registry's host name, not '$registry'"
  [[ $user =~ ^[A-Za-z0-9._-]+$ ]] || fail "--registry needs --registry-user <user>"
  # the token, on stdin, into a configuration of its own: never in root's ~/.docker
  config=$(mktemp -d)
  if DOCKER_CONFIG=$config docker login "$registry" -u "$user" --password-stdin > /dev/null; then
    DOCKER_CONFIG=$config compose pull --quiet || status=$?
  else
    status=1
  fi
  rm -rf "$config"
  return "$status"
}

cmd_register() {
  local args=() var value
  stage
  snapshot_src
  while [ $# -gt 0 ]; do
    case "$1" in
      --realm | --themes | --proxy)
        [ $# -ge 2 ] || usage
        value=$(staged_path "$2") || exit 1
        args+=("$1" "$value")
        shift 2
        ;;
      --rabbitmq-user)
        [ $# -ge 2 ] || usage
        args+=("$1" "$2")
        shift 2
        ;;
      --rabbitmq-password-env)
        # the password, from the application's .env, under a name of c4-app's: the application's
        # variable name never reaches root's environment
        [ $# -ge 2 ] || usage
        var=$2
        [[ $var =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail "--rabbitmq-password-env takes a variable name, not '$var'"
        value=$(env_value "$var") || fail "$var of ~/$app/.env is refused (above)"
        [ -n "$value" ] || fail "$var is not set in ~/$app/.env"
        export C4_APP_RABBITMQ_PASSWORD=$value
        args+=(--rabbitmq-password-env C4_APP_RABBITMQ_PASSWORD)
        shift 2
        ;;
      --reset-realms)
        args+=("$1")
        shift
        ;;
      --app) fail "the application is the account's own ($app): no --app" ;;
      *) fail "unknown option $1 (register takes --realm, --themes, --proxy, --rabbitmq-user, --rabbitmq-password-env, --reset-realms)" ;;
    esac
  done
  bash "$STACK/register-app.sh" --app "$app" "${args[@]}" < /dev/null
}

command=${1:-}
[ $# -eq 0 ] || shift
case "$command" in
  pull) cmd_pull "$@" ;;
  up)
    [ $# -eq 0 ] || usage
    stage
    read_model
    # the file compose runs is the one checked: root's, outside anything a container may mount
    check_model
    bash "$STACK/networks.sh" ensure "$app" < /dev/null
    compose up -d --wait --remove-orphans
    ;;
  down)
    [ $# -eq 0 ] || usage
    stage
    read_model
    # down runs pre_stop hooks and a provider's down: the model it hands compose is checked too
    check_model
    compose down --remove-orphans
    ;;
  register) cmd_register "$@" ;;
  *) usage ;;
esac
