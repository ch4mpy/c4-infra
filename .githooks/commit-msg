#!/usr/bin/env bash
# Git commit-msg hook of the project (core.hooksPath = .githooks): git runs it on the message of each commit
# (commit, --amend, a rebase's reword), whoever makes it; applypatch-msg runs it for git am. It runs the
# pipeline's own subject check, ci/check-commit-subjects.sh --message, as the commit's index holds it (what the
# pipeline will run on that commit, never the working tree's): a subject the commit-subjects (GitHub) or
# commit-messages (GitLab) job would refuse is refused here, with the job's message. A merge passes, as the job
# skips merges. No ci/check-commit-subjects.sh in the index, or one that fails otherwise than by refusing (an older
# script, without the message mode): the commit goes on, one line saying so.
# Known limit: git am judges a patch by the index before the patch applies; the pipeline judges it after the push.
# Exit status: 0, the commit goes on; 1, it is refused.
set -u

! git rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1 || exit 0
check=$(mktemp) || { echo "Commit subject: commit refused, no temporary file for the subject check" >&2; exit 1; }
trap 'rm -f "$check"' EXIT
if ! git show :ci/check-commit-subjects.sh > "$check" 2> /dev/null; then
  echo "Commit subject: the subject was not checked locally: the index holds no ci/check-commit-subjects.sh; the pipeline checks it" >&2
  exit 0
fi
verdict=$(bash "$check" --message "$1" 2>&1 > /dev/null)
status=$?
[ "$status" -ne 0 ] || exit 0
if [ "$status" -ne 1 ]; then
  echo "Commit subject: the subject was not checked locally: the index's ci/check-commit-subjects.sh --message exited $status (a script older than its message mode?); the pipeline checks it" >&2
  exit 0
fi
printf '%s\n' "$verdict" >&2
if [ "${GITHOOKS_CALLER:-}" = applypatch-msg ]; then
  echo "Commit subject: patch refused. Run git am --abort, reword the patch's Subject: line, then git am it again; never --no-verify." >&2
else
  echo "Commit subject: commit refused. Reword it and commit again (git commit --amend for the last commit); never --no-verify." >&2
fi
exit 1
