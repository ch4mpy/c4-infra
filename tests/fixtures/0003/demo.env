# Dummy values, so that `docker compose -f compose.yml -f compose.demo.yml --env-file <this> config`
# interpolates the demo host's model (tests/0003-compose.sh); no secret of any host
INFRA_HOST=infra.c4-soft.com
INFRA_ENV=demo
TZ=Pacific/Tahiti
KC_IMAGE=ghcr.io/ch4mpy/c4-infra-keycloak:000000000000
KC_LOG_LEVEL=INFO
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dummy
KC_DB_PASSWORD=dummy
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=dummy
MAILPIT_SMTP_USER=mailpit
MAILPIT_SMTP_PASSWORD=dummy
MAILPIT_UI_PASSWORD_HASH=dummy
GRAFANA_ADMIN_PASSWORD=dummy
PROXY_IMAGE=ghcr.io/ch4mpy/c4-infra-reverse-proxy:000000000000
