# The shared reverse proxy, in dev as on the demo host: the shared services on {$INFRA_HOST}, and one
# site per application (apps/*.caddy, generated by register-app.sh from the application's routes
# file and its registry entry). What differs between the two environments is in env/dev.caddy and
# env/demo.caddy, picked by INFRA_ENV (.env): the certificate, HSTS and RabbitMQ's UI (Mailpit asks
# for its own credentials on the demo host: intent 0007). Caddy sets X-Forwarded-* itself and streams text/event-stream responses (the
# gateways' SSE) unbuffered.
import env/{$INFRA_ENV}.caddy

# Headers every site sends (through the site snippet). Caddy sends no HSTS on its own: env-hsts adds
# it on the demo host only, so that browsers don't pin the workstation's host names.
(common-headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	import env-hsts
}

# For the single-page applications only. Keycloak serves its own pages under /auth/* and uses
# iframes for session status, so a blanket frame-ancestors would be its problem, not theirs. The
# values once, one directive per field: imported with "", they are set; with ?, each one is a default
# for a response that lacks it (one block of ? would default all or nothing: intent 0015).
(spa-header-values) {
	header {args[0]}Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	header {args[0]}X-Frame-Options "DENY"
	header {args[0]}Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
}
(spa-headers) {
	import spa-header-values ""
}
# A front end that sends its own policy (headers=app in its routes file, intent 0015): the shared
# values only where its response lacks one; the marker gives the proxy's own errors the same
(spa-headers-app) {
	vars app_headers yes
	import spa-header-values ?
}

# The start of every site, the shared host's and each application's. The responses the proxy makes
# itself (a 413, a 502, the rate limit's 429…) skip the deferred headers: handle_errors gives them
# the common ones, and on a headers=app route the shared values as defaults (intent 0015).
(site) {
	encode zstd gzip
	import env-tls
	import common-headers
	# Caddy logs an error handle_errors handles at DEBUG only: an access log of those requests alone,
	# with their cause, keeps an upstream that doesn't answer in `docker compose logs reverse-proxy`
	log {
		output stderr
	}
	log_skip
	handle_errors {
		vars log_skip false
		log_append error {err.message}
		import common-headers
		@app-headers vars app_headers yes
		handle @app-headers {
			import spa-header-values ?
		}
	}
}

{$INFRA_HOST} {
	import site

	handle /auth/* {
		# A realm's client registration endpoint, which a realm may open to anonymous clients (an MCP
		# client's dynamic registration), into the database every application shares: 10 requests a
		# minute per client address, 429 beyond (intent 0013). Inside a route: in the order written,
		# with no global option (the rate-limit module of reverse-proxy/Dockerfile).
		route {
			rate_limit {
				zone client_registrations {
					match {
						path_regexp ^/auth/realms/[^/]+/clients-registrations(/|$)
					}
					key {remote_host}
					events 10
					window 1m
				}
			}
			reverse_proxy keycloak:8080
		}
	}

	# RFC 8414 discovery, which MCP clients use: the well-known path is inserted before the
	# issuer's path, on the issuer's host (this one), for every realm
	@realm-discovery path_regexp discovery ^/\.well-known/(oauth-authorization-server|openid-configuration)/auth/realms/([A-Za-z0-9_.-]+)$
	handle @realm-discovery {
		rewrite * /auth/realms/{re.discovery.2}/.well-known/{re.discovery.1}
		reverse_proxy keycloak:8080
	}

	# on the demo host, Mailpit asks for its credentials itself (MP_UI_AUTH)
	handle /mailpit/* {
		reverse_proxy mailpit:8025
	}

	handle /grafana/* {
		reverse_proxy grafana-lgtm:3000
	}

	import env-infra-routes

	# the landing page register-app.sh writes (intent 0048): the applications and their accounts, on
	# Keycloak's origin, so no script, no form, no frame, nothing fetched; not to be indexed
	handle / {
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		header X-Robots-Tag "noindex"
		root * /etc/caddy/html
		rewrite * /index.html
		file_server
	}

	handle {
		respond "c4-infra: the applications are on their own host names" 404
	}
}

import apps/*.caddy
