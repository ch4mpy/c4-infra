# The demo host's side of the shared Caddyfile (INFRA_ENV=demo): a Let's Encrypt certificate per
# site (Caddy's default), HSTS, and no RabbitMQ route. Mailpit asks for its credentials itself
# (MP_UI_AUTH, compose.demo.yml: intent 0007), through Caddy as from a container.

(env-tls) {
}

(env-hsts) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(env-infra-routes) {
}
