# The dev side of the shared Caddyfile (INFRA_ENV=dev): the leaf of certs/make-certs.sh, signed by
# the local CA; no HSTS; RabbitMQ's management UI on the shared host (Mailpit asks for no
# credentials in dev). Nothing of it answers from the network: the ports are on 127.0.0.1
# (compose.dev.yml).

(env-tls) {
	tls /certs/tls.crt /certs/tls.key
}

(env-hsts) {
}

(env-infra-routes) {
	handle /rabbitmq/* {
		reverse_proxy rabbitmq:15672
	}
}
