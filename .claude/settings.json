{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "f=\"$HOME/.claude/hooks/protect-paths.sh\"; [ ! -f \"$f\" ] || bash \"$f\"", "timeout": 30 },
          { "type": "command", "command": "f=\"$HOME/.claude/hooks/freeze-tests.sh\"; [ ! -f \"$f\" ] || bash \"$f\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          { "type": "command", "command": "f=\"$HOME/.claude/hooks/release-gate.sh\"; [ ! -f \"$f\" ] || bash \"$f\"", "timeout": 30 },
          { "type": "command", "command": "f=\"$HOME/.claude/hooks/commit-guard.sh\"; [ ! -f \"$f\" ] || bash \"$f\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "f=\"$HOME/.claude/hooks/release-gate.sh\"; [ ! -f \"$f\" ] || bash \"$f\"", "timeout": 30 },
          { "type": "command", "command": "f=\"$HOME/.claude/hooks/commit-guard.sh\"; [ ! -f \"$f\" ] || bash \"$f\"", "timeout": 30 }
        ]
      }
    ]
  }
}
